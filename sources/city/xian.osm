    <tag k="name" v="建瓴一路"/>
    <tag k="name:en" v="Jianling 1st Road"/>
    <tag k="name:zh" v="建瓴一路"/>
    <tag k="oneway" v="yes"/>
    <tag k="source" v="http://mzj.xa.gov.cn/web_files/mzj/file/2023/10/16/202310160914579227721.pdf"/>
  </way>
