    <tag k="description" v="命名依据：“建”意为建造、树立、成立、创立之意，“祥”有幸福、吉祥、和谐之意，因道周边均为居民小区，取“建祥”作为道路专名并序列化，寓意建设美好家园，共享祥和盛世的美好寓意"/>
    <tag k="highway" v="tertiary"/>
    <tag k="name" v="建祥三路"/>
    <tag k="name:en" v="Jianxiang 3rd Road"/>
    <tag k="name:zh" v="建祥三路"/>
    <tag k="source" v="http://mzj.xa.gov.cn/web_files/mzj/file/2023/10/16/202310160914579227721.pdf"/>
  </way>
