    <tag k="access" v="yes"/>
    <tag k="addr:city" v="深圳市"/>
    <tag k="addr:district" v="福田区"/>
    <tag k="addr:postcode" v="518017"/>
    <tag k="addr:province" v="广东省"/>
    <tag k="addr:street" v="皇岗四街"/>
    <tag k="alt_name" v="深圳市锦绣园"/>
    <tag k="description" v="皇岗村锦绣园位于深圳市福田区皇岗村，是目前深圳市内唯一一座具有苏式园林风格的公园，是皇岗庄氏宗族“家”文化的纪念园林。锦绣园于1998年奠基，1999年开园，2016年进行整体翻新，占地面积约2万平方米，园林设计、工匠技艺及太湖石等主要建筑材料均来自苏杭地区。观之令人流连忘返，仿若置身江南水乡。"/>
    <tag k="dog" v="no"/>
    <tag k="image" v="https://cgj.sz.gov.cn/attachment/1/1345/1345946/10809042.jpg"/>
    <tag k="leisure" v="park"/>
    <tag k="name" v="锦绣园"/>
    <tag k="opening_hours" v="Mo-Su 06:00-18:00"/>
    <tag k="operator" v="深圳市皇岗实业股份有限公司"/>
    <tag k="operator:type" v="government"/>
    <tag k="smoking" v="no"/>
    <tag k="start_date" v="1998-09-01"/>
  </way>
